{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".windsurf/**",
    "tools/oxlint/anti-slop/**",
    "types/**",
    "**/worker-configuration.d.ts",
    "vendor/**",
    "src/templates-embedded.ts"
  ],
  "jsPlugins": [
    {
      "name": "anti-slop",
      "specifier": "./tools/oxlint/anti-slop/index.ts"
    },
    {
      "name": "sproutboat",
      "specifier": "./.oxlint/sproutboat/index.ts"
    }
  ],
  "overrides": [
    {
      // Comments here are bytes that matter, so they are left as they are: an edit changes a build or generation identity,
      // or the file is code someone copies, or it has to stay verbatim. Trim them in a change that accepts that.
      //  - build.ts, compile.ts, sqlite.ts, bearssl.ts, toolchain.ts: hashed by integrationIdentity() (build.ts) into the compile key
      //  - node-shims.ts, bundle.ts: shim sources and stubs injected into the app bundle, which is hashed and compiled
      //  - templates/**: copied into user projects and embedded verbatim in src/templates-embedded.ts
      //  - examples/*/**, dogfood/**, bench/**, test/fixtures: apps the benchmarks and conformance runs build and compare
      "files": [
        "src/build.ts",
        "src/compile.ts",
        "src/sqlite.ts",
        "src/bearssl.ts",
        "src/toolchain.ts",
        "src/node-shims.ts",
        "src/bundle.ts",
        "templates/**",
        "examples/*/**",
        "dogfood/**",
        "bench/**",
        "test/fixtures/*/src/**",
        "test/fixtures/workers-verbatim/**",
        "test/fixtures/runtime-comparison/**"
      ],
      "rules": { "sproutboat/max-comment-lines": "off" }
    },
    {
      "files": ["examples/*/src/**", "examples/*/*/src/**", "dogfood/*/src/**", "test/fixtures/*/src/**"],
      "rules": { "anti-slop/require-safety-comment-for-type-assertion": "off" }
    },
    {
      // The starters are code for people to copy into their own projects, so they are written as standard Workers
      // TypeScript (typeof checks on a parsed body, a Record for a JSON object), not in this repository's dialect.
      "files": ["templates/**"],
      "rules": {
        "anti-slop/no-chained-type-assertions": "off",
        "anti-slop/no-conditional-empty-object-spread": "off",
        "anti-slop/no-known-value-widening": "off",
        "anti-slop/no-module-mocking": "off",
        "anti-slop/no-object-parameters": "off",
        "anti-slop/no-reflect-apply": "off",
        "anti-slop/no-reflect-get": "off",
        "anti-slop/no-runtime-typeof": "off",
        "anti-slop/no-shape-in-symbol-names": "off",
        "anti-slop/no-unknown-parameters": "off",
        "anti-slop/no-unknown-returns": "off",
        "anti-slop/no-unknown-type-aliases": "off",
        "anti-slop/no-unsafe-dictionary-type": "off",
        "anti-slop/no-widen-then-assert": "off",
        "anti-slop/require-safety-comment-for-type-assertion": "off"
      }
    }
  ],
  "rules": {
    "sproutboat/max-comment-lines": "error",
    "anti-slop/no-chained-type-assertions": "error",
    "anti-slop/no-conditional-empty-object-spread": "error",
    "anti-slop/no-known-value-widening": "error",
    "anti-slop/no-module-mocking": "error",
    "anti-slop/no-object-parameters": "error",
    "anti-slop/no-reflect-apply": "error",
    "anti-slop/no-reflect-get": "error",
    "anti-slop/no-runtime-typeof": "error",
    "anti-slop/no-shape-in-symbol-names": "error",
    "anti-slop/no-unknown-parameters": "error",
    "anti-slop/no-unknown-returns": "error",
    "anti-slop/no-unknown-type-aliases": "error",
    "anti-slop/no-unsafe-dictionary-type": "error",
    "anti-slop/no-widen-then-assert": "error",
    "anti-slop/require-safety-comment-for-type-assertion": "error"
  }
}
